# Copy this file to `.env` (same directory) and fill in real values.
# docker compose reads `.env` automatically; never commit the real file.

# JWT signing key for the API. Required when authentication is enabled
# (the Docker stack enables it). HS256 needs at least 32 characters.
# Generate one with:
#   dotnet script -e "Console.WriteLine(Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(48)))"
# or in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
GDS_AUTH_SIGNING_KEY=
