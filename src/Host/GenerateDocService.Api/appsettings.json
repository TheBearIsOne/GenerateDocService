{
  "DocumentProcessing": {
    "Persistence": {
      "Provider": "InMemory",
      "PostgreSql": {
        "ConnectionString": "Host=localhost;Port=5432;Database=generatedocservice;Username=postgres;Password=postgres"
      }
    },
    "Caching": {
      "Provider": "InMemory",
      "Redis": {
        "ConnectionString": "localhost:6379",
        "KeyPrefix": "generatedocservice",
        "GeneratedDocumentTtlMinutes": 60,
        "DeduplicationTtlMinutes": 15,
        "CompiledTemplateTtlMinutes": 30
      }
    },
    "Messaging": {
      "Transport": "InMemory",
      "QueueName": "document-generation",
      "RabbitMq": {
        "Host": "localhost",
        "Port": 5672,
        "VirtualHost": "/",
        "Username": "guest",
        "Password": "guest"
      }
    },
    "Storage": {
      "Provider": "InMemory",
      "ObjectStorage": {
        "Endpoint": "http://localhost:9000",
        "BucketName": "documents",
        "AccessKey": "minioadmin",
        "SecretKey": "minioadmin",
        "UseSsl": false,
        "CreateBucketIfMissing": true
      }
    },
    "Validation": {
      "MaxPayloadSizeBytes": 10485760,
      "MaxTemplateSizeBytes": 5242880,
      "MaxMetadataEntries": 50,
      "MaxMetadataKeyLength": 128,
      "MaxMetadataValueLength": 1024,
      "MaxEngineNameLength": 64,
      "MaxFormatNameLength": 64,
      "MaxRequestIdLength": 64
    },
    "Authentication": {
      "Enabled": false,
      "Issuer": "GenerateDocService",
      "Audience": "GenerateDocService.Api",
      "SigningKey": ""
    },
    "Retention": {
      "RetentionDays": 30,
      "FailedTaskRetentionDays": 7,
      "CleanupIntervalHours": 1,
      "StuckProcessingTaskSeconds": 1800
    },
    "InMemory": {
      "GeneratedDocumentTtlMinutes": 60,
      "MaxCachedDocuments": 1000,
      "DeduplicationTtlMinutes": 15
    },
    "Resilience": {
      "ProcessingTimeoutSeconds": 300,
      "MaxAttempts": 3,
      "InitialDelayMilliseconds": 250,
      "MaxDelayMilliseconds": 5000,
      "BackoffMultiplier": 2.0
    },
    "Fop": {
      "BaseUrl": "http://localhost:8080/",
      "AttemptTimeoutSeconds": 30,
      "TotalTimeoutSeconds": 120,
      "MaxRetryAttempts": 2,
      "RetryBaseDelayMilliseconds": 1000,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerSamplingDurationSeconds": 60,
      "CircuitBreakerBreakDurationSeconds": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "Tracing": {
      "OtlpEndpoint": ""
    }
  },
  "AllowedHosts": "*"
}
