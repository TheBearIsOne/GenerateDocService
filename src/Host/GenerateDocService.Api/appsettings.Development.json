{
  "DocumentProcessing": {
    "Authentication": {
      "Enabled": false
    },
    "Persistence": {
      "Provider": "InMemory"
    },
    "Caching": {
      "Provider": "InMemory"
    },
    "Messaging": {
      "Transport": "InMemory"
    },
    "Storage": {
      "Provider": "InMemory",
      "ObjectStorage": {
        "CreateBucketIfMissing": true
      }
    },
    "Api": {
      "Targets": {
        "converter": {
          "BaseUrl": "http://localhost:8080/",
          "RequestPath": "api/v1/convert/sync?payloadType=XSL_FO&outputFormat=PDF&correlationId={correlationId}",
          "ContentType": "application/xml",
          "MultipartFieldName": "primaryDocument",
          "InputFormat": "xsl-fo",
          "OutputFormat": "pdf",
          "TimeoutSeconds": 120
        }
      }
    }
  },
  "MassTransit": {
    "License": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "Tracing": {
      "OtlpEndpoint": ""
    }
  }
}
